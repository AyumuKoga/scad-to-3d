{
  "name": "scad-to-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/prepare-assets.mjs && node scripts/prepare-source.mjs && tsc --noEmit && vite build && node scripts/prepare-password-gate.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "preview:protected": "wrangler pages dev dist --ip 127.0.0.1 --port 8788",
    "test:protected": "playwright test --config playwright.protected.config.ts"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/three": "0.186.0",
    "fflate": "0.8.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "wrangler": "4.135.0"
  }
}
